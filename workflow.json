    {
      "parameters": {
        "jsCode": "const offers = items.map(i => i.json);\nconst prices = offers.map(o => parseFloat(o.price));\nconst deliveries = offers.map(o => parseFloat(o.deliveryDays));\nconst minPrice = Math.min(...prices);\nconst minDelivery = Math.min(...deliveries);\n\nconst scored = offers.map(o => {\n  const priceScore = (minPrice / parseFloat(o.price)) * 40;\n  const deliveryScore = (minDelivery / parseFloat(o.deliveryDays)) * 30;\n  const ratingScore = (parseFloat(o.rating) / 5) * 30;\n  const totalScore = (priceScore + deliveryScore + ratingScore).toFixed(1);\n  return { ...o, totalScore };\n}).sort((a,b) => b.totalScore - a.totalScore);\n\nreturn [{ json: { offers: scored, rfqId: offers[0]?.rfqId } }];"
      },
